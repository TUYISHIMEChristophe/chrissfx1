5.75 0 0 1-1.5 0V3a1 1 0 1 0-2 0"}}]}],"onActive":"","collectionId":"fluent","iconId":"hand-right-28-filled"},{"type":"text","attributes":{"id":"imzmb"},"components":[{"type":"textnode","content":"Say Hello"}]}]}],"snap":"","snap-divisions":12},{"type":"heading","attributes":{"id":"in5pi"},"components":[{"type":"textnode","content":"I’m Tuyishime Christophe         \n              "},{"tagName":"br","void":true},{"tagName":"span","type":"text","attributes":{"id":"iuyJJ","data-gs-mrk-wrap":"true"},"components":[{"type":"textnode","content":"Forex Trading\n                "},{"tagName":"br","void":true},{"type":"textnode","content":" Mentor\n                "},{"tagName":"br","void":true}]},{"tagName":"span","type":"text","attributes":{"id":"iVvZR","data-gs-mrk-wrap":"true"},"components":[{"type":"textnode","content":"Based in Rwanda."}]}]},{"type":"text","attributes":{"id":"if2c3rs"},"components":[{"type":"textnode","content":"I am a Forex and Gold (XAUUSD) trading mentor focused on helping traders understand the market in a clear and practical way. I teach traders how to read price action, identify high-probability trade setups, and manage risk correctly so they can trade with confidence and consistency. My goal is to move traders away from emotional decisions, random entries, and dependency on signals, and instead help them build a strong trading plan they can follow every day. I believe trading success comes from discipline, patience, and proper risk management, not from shortcuts or gambling. Through structured education, real market examples, and mindset training, I help traders develop the skills needed to think independently, control emotions, and grow steadily in the Forex market over the long term."}]},{"type":"flex-row","classes":["gjs-plg-flex-row"],"attributes":{"data-type-role":"flex-row","id":"ibgbr"},"components":[{"type":"flex-column","classes":["gjs-plg-flex-column"],"attributes":{"data-type-role":"flex-column","id":"ijfk9"},"components":[{"type":"he